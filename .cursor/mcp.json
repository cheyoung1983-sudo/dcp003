{
  "mcpServers": {
    "auth0": {
      "command": "npx",
      "args": ["-y", "@auth0/auth0-mcp-server", "run"],
      "capabilities": ["tools"],
      "env": {
        "DEBUG": "auth0-mcp"
      }
    },
    "autonoma": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "--header", "X-Onboarding-Code: VNTPA9VD", "https://api.autonoma.app/v1/mcp/onboarding"],
      "capabilities": ["tools"]
    }
  }
}
